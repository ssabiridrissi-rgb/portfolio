# All variables are optional — the site works without any of them.

# Public URL of the site (used for canonical URLs, sitemap, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://saad-sabir-idrissi.vercel.app

# Contact form: without RESEND_API_KEY the form falls back to a pre-filled mailto: link.
RESEND_API_KEY=
# Where messages are delivered (defaults to the email in src/content/profile.ts).
CONTACT_TO_EMAIL=
# Sender — must be a domain verified in Resend (defaults to "Portfolio <onboarding@resend.dev>").
CONTACT_FROM_EMAIL=

# Optional GitHub token (no scope needed) to raise the API rate limit for the GitHub section.
GITHUB_TOKEN=
